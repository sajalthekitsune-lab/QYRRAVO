# Copy to .env and edit. NEVER commit .env. Secrets belong ONLY on the server.
NODE_ENV=development
PORT=3000
# Public address of the site (used in emails, cookies and CSRF origin checks). Use https:// in production.
APP_URL=http://localhost:3000
DATABASE_PATH=./data/qyrravo.db
UPLOAD_DIR=./uploads
# Set to 1 only if you run behind a reverse proxy you control (so client IPs come from X-Forwarded-For).
TRUST_PROXY=0
SUPPORT_EMAIL=qyrravo@gmail.com

# ---- Payments ----
# off  = checkout and Premium purchase disabled (safe default in production)
# test = built-in SIMULATOR. No real money. Refuses to start with NODE_ENV=production.
# live = a real provider adapter (the Tap adapter is NOT implemented in this build - see docs/PAYMENTS.md)
PAYMENT_MODE=test
PAYMENT_PROVIDER=test
# Provider secret key - server side only. Never put this in /public or in git.
PAYMENT_SECRET_KEY=
# Required for live mode. Shared secret used to verify webhook signatures.
PAYMENT_WEBHOOK_SECRET=

# ---- Email (optional). Without it, emails are recorded as "not configured" and NEVER reported as sent ----
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=

# ---- v3: owner account (REQUIRED for the owner login) ----
# The owner logs in with this email + password. Use a STRONG password that is NOT another email address.
OWNER_EMAIL=qyrravo@gmail.com
OWNER_PASSWORD=
# Optional: makes the help bot use Claude (otherwise it answers from a built-in list)
ANTHROPIC_API_KEY=
# Payments stay off: customers contact qyrravo@gmail.com to buy items and plans.
PAYMENT_MODE=off
# Google sign-in (create an OAuth Client in Google Cloud Console > APIs & Services > Credentials; type "Web application").
# Authorized redirect URI must be exactly: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Help bot using Google Gemini (key starts with "AQ." or "AIza"). Put your key here, on the server only, never in code.
GEMINI_API_KEY=
